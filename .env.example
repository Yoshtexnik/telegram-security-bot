BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321
BOT_USERNAME=your_bot_username
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/security_bot
LOG_LEVEL=INFO

NSFW_DELETE_THRESHOLD=0.90
NSFW_WARN_THRESHOLD=0.75
FLOOD_LIMIT=8
FLOOD_WINDOW_SECONDS=10
MAX_FILE_SIZE_MB=25
TEMP_ROOT=/tmp/security_bot

VIRUSTOTAL_API_KEY=
VIRUSTOTAL_UPLOAD_UNKNOWN=false

URL_SHORTENER_ENABLED=false
YARA_ENABLED=false

APP_MODE=prod
